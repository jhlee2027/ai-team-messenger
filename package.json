{
  "name": "ai-team-messenger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:api": "wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^16.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.11",
    "jsdom": "^29.1.1",
    "miniflare": "^4.20251011.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "wrangler": "^4.45.0"
  }
}
